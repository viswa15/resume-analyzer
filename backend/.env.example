# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- PostgreSQL (local dev) ---
DB_USER=your_postgres_user
DB_HOST=localhost
DB_DATABASE=resume_analyzer
DB_PASSWORD=your_postgres_password
DB_PORT=5432
DB_SSL=false

# --- PostgreSQL (production) ---
# Used instead of the DB_* vars above when NODE_ENV=production.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google Gemini ---
GOOGLE_API_KEY="YOUR_GEMINI_API_KEY"
# Comma-separated, tried in order: if one model 404s (withdrawn/invalid), exhausts its
# daily free-tier quota, or keeps failing transiently, the backend automatically falls
# forward to the next one for that same request - no manual restart needed.
GEMINI_MODEL=gemini-3.6-flash,gemini-flash-latest,gemini-flash-lite-latest

# Max Gemini requests/minute this server will self-throttle to, shared across
# all AI features. Keep at or below your key's actual free-tier RPM for the
# chosen model (Google's own 429 error body names the exact limit, e.g.
# "limit: 5, model: gemini-3.8-flash") - see https://ai.google.dev/gemini-api/docs/rate-limits.
# Raise this if you're on a paid tier with a higher quota.
GEMINI_RPM_LIMIT=5

# --- Job search (Adzuna) ---
# Free at https://developer.adzuna.com/ - register an app to get an app_id/app_key pair.
# Job matching gracefully returns a 503 with a clear message if these are unset.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# Adzuna country code to search (e.g. "in", "us", "gb") - see their docs for the full list.
ADZUNA_COUNTRY=in

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API, e.g.
# https://your-app.vercel.app. Leave unset to allow any origin (fine for local dev).
# CORS_ORIGIN=https://your-app.vercel.app

# --- Logging ---
LOG_LEVEL=info
